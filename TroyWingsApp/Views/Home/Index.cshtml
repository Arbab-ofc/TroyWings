@model TroyWingsApp.Models.Registration
@{
    ViewData["Title"] = "Register | Troywings Technologies";
}

@section Head {
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register | Troywings Technologies</title>
    <meta name="description" content="Create your Troywings Technologies account to access innovation, training, and premium services." />
    <link rel="canonical" href="https://www.example.com/register" />
    <meta property="og:title" content="Register | Troywings Technologies" />
    <meta property="og:description" content="Join Troywings Technologies to collaborate on research, training, and product innovation." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.example.com/register" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/registration.css" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "Troywings Technologies",
      "url": "https://www.example.com",
      "logo": "https://www.example.com/assets/logo.svg",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "123 Placeholder Avenue",
        "addressLocality": "Your City",
        "addressRegion": "Your State",
        "postalCode": "000000",
        "addressCountry": "IN"
      },
      "foundingDate": "2021"
    }
    </script>
}

<div class="registration-page py-4">
    <header class="top-brand py-3">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand-link d-inline-flex align-items-center gap-2" href="/" aria-label="Troywings Technologies home">
                <span class="brand-icon-soft"><i class="bi bi-gem"></i></span>
                <span class="fw-semibold brand-text">Troywings Technologies</span>
            </a>
        </div>
    </header>

    <main class="container registration-shell">
        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-lg-5 order-2 order-lg-1">
                <div class="card premium-card h-100 fade-slide-left">
                    <div class="card-body p-4 p-xl-5 d-flex flex-column gap-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <h1 class="display-6 mb-0 title-serif brand-title" style="color:#ffd166;">Troywings Technologies</h1>
                            <span class="badge rounded-pill founded-pill">Founded 2021</span>
                        </div>
                        <p class="lead text-soft">
                            We blend research, innovation, and purposeful engineering to create products and services that solve real-world problems while uplifting people and businesses.
                        </p>
                        <ul class="list-unstyled d-grid gap-3">
                            <li class="d-flex gap-3 align-items-start">
                                <span class="icon-circle"><i class="bi bi-lightbulb"></i></span>
                                <div>
                                    <div class="fw-semibold" style="color:#fefefe;">Research & innovation that unlocks solutions</div>
                                    <div class="text-soft">Insights move swiftly into prototypes and production.</div>
                                </div>
                            </li>
                            <li class="d-flex gap-3 align-items-start">
                                <span class="icon-circle"><i class="bi bi-cpu"></i></span>
                                <div>
                                    <div class="fw-semibold" style="color:#fefefe;">Product development & services</div>
                                    <div class="text-soft">High-touch delivery across design, build, and support.</div>
                                </div>
                            </li>
                            <li class="d-flex gap-3 align-items-start">
                                <span class="icon-circle"><i class="bi bi-mortarboard"></i></span>
                                <div>
                                    <div class="fw-semibold" style="color:#fefefe;">Practical engineering training</div>
                                    <div class="text-soft">Mentored programs with industry tools and processes.</div>
                                </div>
                            </li>
                            <li class="d-flex gap-3 align-items-start">
                                <span class="icon-circle"><i class="bi bi-heart-pulse"></i></span>
                                <div>
                                    <div class="fw-semibold" style="color:#fefefe;">Value-first culture</div>
                                    <div class="text-soft">Employee care, customer delight, and leadership grounded in human values.</div>
                                </div>
                            </li>
                            <li class="d-flex gap-3 align-items-start">
                                <span class="icon-circle"><i class="bi bi-globe2"></i></span>
                                <div>
                                    <div class="fw-semibold" style="color:#fefefe;">Impactful ecosystem support</div>
                                    <div class="text-soft">CSR internships (6 &amp; 9 months) teach planning, design, and development through real delivery cycles.</div>
                                </div>
                            </li>
                        </ul>
                        <div class="why-register p-3 p-lg-4 rounded-4 mt-auto">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-stars text-accent"></i>
                                <span class="fw-semibold" style="color:#fefefe;">Why register</span>
                            </div>
                            <p class="mb-0 text-soft">
                                Secure a personalized journey across innovation programs, training cohorts, and premium services designed to enrich engineering and strengthen startups nationwide.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-7 order-1 order-lg-2">
                <div class="card premium-card h-100 fade-slide-right">
                    <div class="card-body p-4 p-xl-5">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <div class="eyebrow text-uppercase">Registration</div>
                                <h2 class="h3 mb-0 title-serif heading-accent" style="color:#ffd166;">Create your account</h2>
                                <p class="text-soft mb-0">Access curated resources, mentorship, and delivery excellence.</p>
                            </div>
                            <i class="bi bi-shield-check text-accent fs-3"></i>
                        </div>
                        @if (TempData["Success"] is string successMessage)
                        {
                            <div class="alert alert-success small" role="alert">@successMessage</div>
                        }
                        @if (TempData["Error"] is string errorMessage)
                        {
                            <div class="alert alert-danger small" role="alert">@errorMessage</div>
                        }
                        <div id="validationSummary" class="alert alert-danger @(ViewData.ModelState.ErrorCount > 0 ? "" : "d-none") small" role="alert" asp-validation-summary="ModelOnly">
                            Please fix the highlighted fields to continue.
                        </div>
                        <form asp-action="Register" asp-controller="Home" method="post" class="row g-3 needs-validation" novalidate>
                            <div class="col-12">
                                <label asp-for="Name" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="Name" type="text" class="form-control" placeholder="Your full name" required minlength="3" maxlength="80" />
                                    <span asp-validation-for="Name" class="invalid-feedback"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <label asp-for="FatherName" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person-heart"></i></span>
                                    <input asp-for="FatherName" type="text" class="form-control" placeholder="Father's full name" required minlength="3" maxlength="80" />
                                    <span asp-validation-for="FatherName" class="invalid-feedback"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" required style="color:#ffffff !important;" />
                                    <span asp-validation-for="DateOfBirth" class="invalid-feedback"></span>
                                </div>
                                <div class="form-text text-muted" style="color:#ffffff !important;">Used to tailor mentoring milestones.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactNumber" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                    <input asp-for="ContactNumber" type="tel" class="form-control" placeholder="+91 98765 43210" required pattern="^(\\+?91[- ]?)?[6-9]\\d{9}$" minlength="10" maxlength="14" />
                                    <span asp-validation-for="ContactNumber" class="invalid-feedback"></span>
                                </div>
                                <div class="form-text text-muted" style="color:#ffffff !important;">We verify contact to keep your account secure.</div>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                    <textarea asp-for="Address" class="form-control" placeholder="Street, city, state" rows="3" required minlength="10" maxlength="180"></textarea>
                                    <span asp-validation-for="Address" class="invalid-feedback"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-accent w-100 py-2" type="submit">
                                    <span>Create Account</span>
                                    <i class="bi bi-arrow-right-short ms-1"></i>
                                </button>
                                <div class="text-center mt-2">
                                    <a href="#" class="link-secondary small" style="color:#ffffff !important;">Already have an account? Sign in</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer-premium mt-5">
        <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="brand-icon-soft"><i class="bi bi-gem"></i></span>
                <div>
                    <div class="fw-semibold">Troywings Technologies</div>
                    <small class="text-soft">Founded 2021 • Engineering with purpose</small>
                </div>
            </div>
            <div class="d-flex gap-3">
                <a href="#" class="footer-link">Privacy</a>
                <a href="#" class="footer-link">Terms</a>
                <a href="#" class="footer-link">Support</a>
            </div>
        </div>
    </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="~/js/registration.js"></script>
