@model object
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    @RenderSection("Head", required: false)
</head>
<body>
    <div class="registration-page py-4">
        <header class="top-brand py-3">
            <div class="container d-flex align-items-center justify-content-between">
                <a class="brand-link d-inline-flex align-items-center gap-2" href="/" aria-label="Troywings Technologies home">
                    <span class="brand-icon-soft"><i class="bi bi-gem"></i></span>
                    <span class="fw-semibold brand-text">Troywings Technologies</span>
                </a>
                <nav class="top-nav d-flex align-items-center" aria-label="Primary">
                    <button class="nav-toggle" type="button" aria-controls="primaryNav" aria-expanded="false">
                        <span class="nav-toggle__icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Toggle navigation</span>
                    </button>
                    <div id="primaryNav" class="nav-links">
                        <a class="nav-link-soft" asp-controller="Users" asp-action="Index">Users</a>
                    </div>
                </nav>
            </div>
        </header>

        @RenderBody()

        <footer class="footer-premium mt-5">
            <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="brand-icon-soft"><i class="bi bi-gem"></i></span>
                    <div>
                        <div class="fw-semibold text-bright">Troywings Technologies</div>
                        <small class="text-soft">Founded 2021 • Engineering with purpose</small>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <a href="#" class="footer-link">Privacy</a>
                    <a href="#" class="footer-link">Terms</a>
                    <a href="#" class="footer-link">Support</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
