@model object
<div class="card premium-card h-100 fade-slide-left">
    <div class="card-body p-4 p-xl-5 d-flex flex-column gap-3">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="display-6 mb-0 title-serif brand-title heading-accent">Troywings Technologies</h1>
            <span class="badge rounded-pill founded-pill">Founded 2021</span>
        </div>
        <p class="lead text-soft">
            We blend research, innovation, and purposeful engineering to create products and services that solve real-world problems while uplifting people and businesses.
        </p>
        <ul class="list-unstyled d-grid gap-3">
            <li class="d-flex gap-3 align-items-start">
                <span class="icon-circle"><i class="bi bi-lightbulb"></i></span>
                <div>
                    <div class="fw-semibold text-bright">Research & innovation that unlocks solutions</div>
                    <div class="text-soft">Insights move swiftly into prototypes and production.</div>
                </div>
            </li>
            <li class="d-flex gap-3 align-items-start">
                <span class="icon-circle"><i class="bi bi-cpu"></i></span>
                <div>
                    <div class="fw-semibold text-bright">Product development & services</div>
                    <div class="text-soft">High-touch delivery across design, build, and support.</div>
                </div>
            </li>
            <li class="d-flex gap-3 align-items-start">
                <span class="icon-circle"><i class="bi bi-mortarboard"></i></span>
                <div>
                    <div class="fw-semibold text-bright">Practical engineering training</div>
                    <div class="text-soft">Mentored programs with industry tools and processes.</div>
                </div>
            </li>
            <li class="d-flex gap-3 align-items-start">
                <span class="icon-circle"><i class="bi bi-heart-pulse"></i></span>
                <div>
                    <div class="fw-semibold text-bright">Value-first culture</div>
                    <div class="text-soft">Employee care, customer delight, and leadership grounded in human values.</div>
                </div>
            </li>
            <li class="d-flex gap-3 align-items-start">
                <span class="icon-circle"><i class="bi bi-globe2"></i></span>
                <div>
                    <div class="fw-semibold text-bright">Impactful ecosystem support</div>
                    <div class="text-soft">CSR internships (6 & 9 months) teach planning, design, and development through real delivery cycles.</div>
                </div>
            </li>
        </ul>
        <div class="why-register p-3 p-lg-4 rounded-4 mt-auto">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-stars text-accent"></i>
                <span class="fw-semibold text-bright">Why register</span>
            </div>
            <p class="mb-0 text-soft">
                Secure a personalized journey across innovation programs, training cohorts, and premium services designed to enrich engineering and strengthen startups nationwide.
            </p>
        </div>
    </div>
</div>
