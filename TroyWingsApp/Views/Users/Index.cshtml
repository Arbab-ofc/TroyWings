@model IReadOnlyList<Registration>
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Users | Troywings Technologies";
}

@section Head {
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Users | Troywings Technologies</title>
    <meta name="description" content="Explore and manage Troywings Technologies registrations in a premium, modern interface." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/registration.css" />
    <link rel="stylesheet" href="~/css/users.css" />
}

<main class="container users-shell" id="usersPage"
      data-update-url="@Url.Action("Update", "Users")">
    <section class="users-intro mb-4">
        <div class="intro-content">
            <div class="intro-tag">Troywings User Atlas</div>
            <h1 class="intro-title">People who power the runway</h1>
            <p class="intro-subtitle">A clean, centralized view of every registered member. Edit profiles without leaving the flow.</p>
        </div>
        <div class="intro-metrics">
            <div class="metric-card">
                <div class="metric-label">Total Members</div>
                <div class="metric-value">@Model.Count</div>
                <div class="metric-foot">Live registry</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Directory</div>
                <div class="metric-value">Active</div>
                <div class="metric-foot">Updated today</div>
            </div>
        </div>
    </section>

    <section class="users-board">
        <div class="board-header">
            <div>
                <div class="board-label">Directory View</div>
                <h2 class="board-title">Members Overview</h2>
            </div>
            <div id="usersStatus" class="board-status">
                Showing @Model.Count user@(Model.Count == 1 ? "" : "s")
            </div>
        </div>

        <div class="users-table-wrapper">
            @if (Model.Count > 0)
            {
                <table class="table users-table" id="usersTable">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Father</th>
                            <th scope="col">Date of Birth</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Address</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var dobValue = user.DateOfBirth?.ToString("yyyy-MM-dd") ?? "";
                            var dobLabel = user.DateOfBirth?.ToString("MMM dd, yyyy") ?? "-";
                            <tr data-user-id="@user.Id"
                                data-name="@user.Name"
                                data-father-name="@user.FatherName"
                                data-dob="@dobValue"
                                data-contact-number="@user.ContactNumber"
                                data-address="@user.Address">
                                <td data-label="Name" data-field="name">@user.Name</td>
                                <td data-label="Father" data-field="fatherName">@user.FatherName</td>
                                <td data-label="Date of Birth" data-field="dateOfBirth">@dobLabel</td>
                                <td data-label="Contact" data-field="contactNumber">@user.ContactNumber</td>
                                <td data-label="Address" data-field="address">@user.Address</td>
                                <td data-label="Actions" class="text-end">
                                    <button class="btn btn-sm edit-user-btn" type="button">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-soft">No users found.</div>
            }
        </div>
    </section>
</main>

<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glassy-modal">
            <div class="modal-header border-0">
                <div>
                    <div class="eyebrow text-uppercase">Edit Profile</div>
                    <h5 class="modal-title title-serif">Refine user details</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editUserId" />
                    <div class="col-12">
                        <label for="editName" class="form-label">Name</label>
                        <input id="editName" type="text" class="form-control" required minlength="3" maxlength="80" />
                    </div>
                    <div class="col-12">
                        <label for="editFatherName" class="form-label">Father's Name</label>
                        <input id="editFatherName" type="text" class="form-control" required minlength="3" maxlength="80" />
                    </div>
                    <div class="col-md-6">
                        <label for="editDob" class="form-label">Date of Birth</label>
                        <input id="editDob" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label for="editContact" class="form-label">Contact Number</label>
                        <input id="editContact" type="tel" class="form-control" required minlength="10" maxlength="14" pattern="^(\+?91[- ]?)?[6-9]\d{9}$" />
                    </div>
                    <div class="col-12">
                        <label for="editAddress" class="form-label">Address</label>
                        <textarea id="editAddress" class="form-control" rows="3" required minlength="10" maxlength="180"></textarea>
                    </div>
                    <div class="col-12">
                        <div id="editUserAlert" class="alert alert-danger d-none small" role="alert"></div>
                    </div>
                    <div class="col-12 d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-accent">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/users.js" asp-append-version="true"></script>
}
