@model object
@{
    Layout = "_RegistrationLayout";
    ViewData["Title"] = "Users | Troywings Technologies";
}

@section Head {
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Users | Troywings Technologies</title>
    <meta name="description" content="Explore and manage Troywings Technologies registrations in a premium, modern interface." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/registration.css" />
    <link rel="stylesheet" href="~/css/users.css" />
}

<main class="container users-shell" id="usersPage"
      data-list-url="@Url.Action("List", "Users")"
      data-update-url="@Url.Action("Update", "Users")"
      data-page-size="4">
    <section class="users-hero mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div>
                <div class="eyebrow text-uppercase">User Registry</div>
                <h1 class="display-6 title-serif mb-2">Your curated roster of Troywings members</h1>
            </div>
            <div class="hero-metric">
                <div class="metric-icon"><i class="bi bi-stars"></i></div>
                <div>
                    <div class="metric-label">Live Directory</div>
                    <div class="metric-value">Always in sync</div>
                </div>
            </div>
        </div>
    </section>

    <section class="users-panel">
        <div class="users-toolbar d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div class="toolbar-title">
                <span class="badge badge-soft">Registrations</span>
            </div>
            <div id="usersStatus" class="status-pill">Loading records...</div>
        </div>

        <div id="usersGrid" class="users-grid"></div>

        <div class="users-pagination mt-4">
            <div id="usersPager" class="pager"></div>
        </div>
    </section>
</main>

<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glassy-modal">
            <div class="modal-header border-0">
                <div>
                    <div class="eyebrow text-uppercase">Edit Profile</div>
                    <h5 class="modal-title title-serif">Refine user details</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editUserId" />
                    <div class="col-12">
                        <label for="editName" class="form-label">Name</label>
                        <input id="editName" type="text" class="form-control" required minlength="3" maxlength="80" />
                    </div>
                    <div class="col-12">
                        <label for="editFatherName" class="form-label">Father's Name</label>
                        <input id="editFatherName" type="text" class="form-control" required minlength="3" maxlength="80" />
                    </div>
                    <div class="col-md-6">
                        <label for="editDob" class="form-label">Date of Birth</label>
                        <input id="editDob" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label for="editContact" class="form-label">Contact Number</label>
                        <input id="editContact" type="tel" class="form-control" required minlength="10" maxlength="14" pattern="^(\+?91[- ]?)?[6-9]\d{9}$" />
                    </div>
                    <div class="col-12">
                        <label for="editAddress" class="form-label">Address</label>
                        <textarea id="editAddress" class="form-control" rows="3" required minlength="10" maxlength="180"></textarea>
                    </div>
                    <div class="col-12">
                        <div id="editUserAlert" class="alert alert-danger d-none small" role="alert"></div>
                    </div>
                    <div class="col-12 d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-accent">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/users.js"></script>
}
